# Application Configuration
PORT=3000
NODE_ENV=production
NEXT_PUBLIC_APP_URL="https://your-portfolio.vercel.app"

# MySQL Database Configuration
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=akshay_portfolio
DB_USER=root
DB_PASSWORD=

# Prisma Connection String (Used on Vercel)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslaccept=strict
DATABASE_URL="mysql://root:@localhost:3306/akshay_portfolio"

# Admin CMS JWT Authentication
ADMIN_EMAIL="admin@portfolio.com"
ADMIN_PASSWORD="adminpassword123"
JWT_SECRET="your_production_secret_key_here"
